{
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error",
				"noImplicitAnyLet": "error",
				"noTsIgnore": "error",
				"noEmptyInterface": "error"
			},
			"style": { "noNonNullAssertion": "error" },
			"nursery": {
				"noMisusedPromises": "error",
				"noUselessTypeConversion": "error"
			}
		}
	}
}
